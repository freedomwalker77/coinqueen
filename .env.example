# Production site: https://myvaultexchange.com
# eBay developer.ebay.com → Application Keys → Production (not Sandbox)
# App ID (Client ID) = EBAY_APP_ID and EBAY_CLIENT_ID (same value)
# Cert ID (Client Secret) = EBAY_CLIENT_SECRET
EBAY_APP_ID=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_CA
# RuName from eBay “Get a Token from eBay via Your Application” (not the https URL)
EBAY_RUNAME=
# Go High Level (optional) — signup creates/updates a Contact
# Sub-account Settings → Private Integrations → contacts.write
GHL_API_KEY=
GHL_LOCATION_ID=
