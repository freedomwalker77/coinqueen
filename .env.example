# Photo ID: OpenRouter (preferred) — https://openrouter.ai/settings/keys
# Uses google/gemini-flash-latest (currently Gemini 3.8 Flash)
OPENROUTER_API_KEY=
# Optional pin, otherwise latest Flash then 3.8 Flash
# OPENROUTER_MODEL=google/gemini-flash-latest
# Optional Google AI Studio fallback if OpenRouter is empty
GEMINI_API_KEY=
SESSION_SECRET=
STRIPE_SECRET_KEY=
# Billing webhook for the $14.97/month Also list on eBay plan (checkout.session.completed + customer.subscription.*)
STRIPE_WEBHOOK_SECRET=
# Comma-separated emails that can list on eBay without the $14.97/month plan
ADMIN_EMAILS=
# Optional Dashboard Price ID; if empty, Checkout creates a $14.97/month price
STRIPE_EBAY_PRICE_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production site: https://myvaultexchange.com
# eBay developer.ebay.com → Application Keys → Production (not Sandbox)
# App ID (Client ID) = EBAY_APP_ID and EBAY_CLIENT_ID (same value)
# Cert ID (Client Secret) = EBAY_CLIENT_SECRET
EBAY_APP_ID=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_CA
# RuName from eBay “Get a Token from eBay via Your Application” (not the https URL)
EBAY_RUNAME=
# Go High Level (optional) — signup creates/updates a Contact
# Sub-account Settings → Private Integrations → contacts.write
GHL_API_KEY=
GHL_LOCATION_ID=
